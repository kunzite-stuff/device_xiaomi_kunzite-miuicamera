From: Arian <arian.kulmer@web.de>
Date: Sun, 8 Nov 2026 21:46:16 -0300
Subject: [PATCH 10/13] Disable automatic Firebase initialization

---
 AndroidManifest.xml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/AndroidManifest.xml b/AndroidManifest.xml
index b4ad0056..e5b7ece8 100644
--- a/AndroidManifest.xml
+++ b/AndroidManifest.xml
@@ -504,7 +504,7 @@
         </service>
         <meta-data android:name="recyclerview_animator" android:value="2.0"/>
         <provider android:authorities="com.android.camera.debug.provider" android:enabled="true" android:exported="true" android:name="com.miui.camerainfra.debug.DebugProvider" android:permission="com.android.camera.permission.DebugProvider"/>
-        <provider android:authorities="com.android.camera.firebaseinitprovider" android:directBootAware="true" android:exported="false" android:initOrder="100" android:name="com.google.firebase.provider.FirebaseInitProvider"/>
+        <provider android:authorities="com.android.camera.firebaseinitprovider" android:directBootAware="true" android:enabled="false" android:exported="false" android:initOrder="100" android:name="com.google.firebase.provider.FirebaseInitProvider"/>
         <activity android:exported="false" android:name="com.google.android.gms.common.api.GoogleApiActivity" android:theme="@android:style/Theme.Translucent.NoTitleBar"/>
         <meta-data android:name="dynamicoverscroller" android:value="2.0"/>
         <meta-data android:name="folme" android:value="2.0"/>
