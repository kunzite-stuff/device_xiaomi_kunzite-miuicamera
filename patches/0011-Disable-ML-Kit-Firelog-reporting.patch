From bf7d2fca181a062b0f18b03fe50b3d7a95255a32 Mon Sep 17 00:00:00 2001
From: Arian <arian.kulmer@web.de>
Date: Sun, 8 Nov 2026 21:49:58 -0300
Subject: [PATCH 11/13] Disable ML Kit Firelog reporting

The optimized option setters ignore their arguments, so disable reporting in the builders.
---
 .../com/google/android/gms/internal/mlkit_common/zzrs.smali   | 4 +++-
 .../android/gms/internal/mlkit_vision_barcode/zzwb.smali      | 4 +++-
 .../android/gms/internal/mlkit_vision_common/zzly.smali       | 4 +++-
 3 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/smali_classes3/com/google/android/gms/internal/mlkit_common/zzrs.smali b/smali_classes3/com/google/android/gms/internal/mlkit_common/zzrs.smali
index a9cff3e5..10a61057 100644
--- a/smali_classes3/com/google/android/gms/internal/mlkit_common/zzrs.smali
+++ b/smali_classes3/com/google/android/gms/internal/mlkit_common/zzrs.smali
@@ -27,10 +27,12 @@
 .method public final zza(Z)Lcom/google/android/gms/internal/mlkit_common/zzsa;
     .locals 1
 
-    const/4 p1, 0x1
+    const/4 p1, 0x0
 
     iput-boolean p1, p0, Lcom/google/android/gms/internal/mlkit_common/zzrs;->zzb:Z
 
+    const/4 p1, 0x1
+
     iget-byte v0, p0, Lcom/google/android/gms/internal/mlkit_common/zzrs;->zzd:B
 
     or-int/2addr p1, v0
diff --git a/smali_classes3/com/google/android/gms/internal/mlkit_vision_barcode/zzwb.smali b/smali_classes3/com/google/android/gms/internal/mlkit_vision_barcode/zzwb.smali
index 4538e286..7d630922 100644
--- a/smali_classes3/com/google/android/gms/internal/mlkit_vision_barcode/zzwb.smali
+++ b/smali_classes3/com/google/android/gms/internal/mlkit_vision_barcode/zzwb.smali
@@ -27,10 +27,12 @@
 .method public final zza(Z)Lcom/google/android/gms/internal/mlkit_vision_barcode/zzwg;
     .locals 1
 
-    const/4 p1, 0x1
+    const/4 p1, 0x0
 
     iput-boolean p1, p0, Lcom/google/android/gms/internal/mlkit_vision_barcode/zzwb;->zzb:Z
 
+    const/4 p1, 0x1
+
     iget-byte v0, p0, Lcom/google/android/gms/internal/mlkit_vision_barcode/zzwb;->zzd:B
 
     or-int/2addr p1, v0
diff --git a/smali_classes3/com/google/android/gms/internal/mlkit_vision_common/zzly.smali b/smali_classes3/com/google/android/gms/internal/mlkit_vision_common/zzly.smali
index bc62cd63..a32d6a8c 100644
--- a/smali_classes3/com/google/android/gms/internal/mlkit_vision_common/zzly.smali
+++ b/smali_classes3/com/google/android/gms/internal/mlkit_vision_common/zzly.smali
@@ -27,10 +27,12 @@
 .method public final zza(Z)Lcom/google/android/gms/internal/mlkit_vision_common/zzmd;
     .locals 1
 
-    const/4 p1, 0x1
+    const/4 p1, 0x0
 
     iput-boolean p1, p0, Lcom/google/android/gms/internal/mlkit_vision_common/zzly;->zzb:Z
 
+    const/4 p1, 0x1
+
     iget-byte v0, p0, Lcom/google/android/gms/internal/mlkit_vision_common/zzly;->zzd:B
 
     or-int/2addr p1, v0
