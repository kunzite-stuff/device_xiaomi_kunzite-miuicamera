From: kleidione Freitas <kleidione@gmail.com>
Date: Mon, 23 Nov 2026 19:38:02 -0300
Subject: [PATCH 08/13] Swap chroma from plane[2] to keep V/U alignment

Signed-off-by: kleidione <kleidione@gmail.com>
---
 .../com/xiaomi/camera/imagecodec/impl/KunziteUvSwap.smali       | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/smali_classes8/com/xiaomi/camera/imagecodec/impl/KunziteUvSwap.smali b/smali_classes8/com/xiaomi/camera/imagecodec/impl/KunziteUvSwap.smali
index 71e55531..92fc4f12 100644
--- a/smali_classes8/com/xiaomi/camera/imagecodec/impl/KunziteUvSwap.smali
+++ b/smali_classes8/com/xiaomi/camera/imagecodec/impl/KunziteUvSwap.smali
@@ -108,7 +108,7 @@
 
     if-ne v6, v7, :cond_planar
 
-    invoke-static {p0, v4}, Lcom/xiaomi/camera/imagecodec/impl/KunziteUvSwap;->processPlane(Landroid/media/Image;Landroid/media/Image$Plane;)Z
+    invoke-static {p0, v3}, Lcom/xiaomi/camera/imagecodec/impl/KunziteUvSwap;->processPlane(Landroid/media/Image;Landroid/media/Image$Plane;)Z
     move-result v3
 
     if-eqz v3, :cond_return
